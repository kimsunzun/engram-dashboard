{
  "$schema": "https://schema.tauri.app/config/2",

  // ADR-0137 — dev 빌드에 별도 번들 identifier(릴리스 앱과 동시 실행)
  // ★dev 전용 오버레이 — 릴리즈(`tauri.conf.json`)의 identifier 와 절대 통일하지 말 것(되살리지 마라)★
  //   tauri-plugin-single-instance 는 Windows 전역 뮤텍스 이름을 `{identifier}-sim` 으로 만든다
  //   (실측: tauri-plugin-single-instance 2.4.2 `src/platform_impl/windows.rs:67`). 두 빌드가 같은
  //   identifier 를 쓰면 같은 뮤텍스를 잡으므로, 릴리즈 앱이 떠 있는 동안 dev 앱은 창도 자기 데몬도
  //   없이 즉시 종료된다(실측). 플러그인 Builder 는 Windows 용 이름 override 를 노출하지 않아
  //   (`callback` 과 Linux 전용 `dbus_id` 뿐) identifier 를 가르는 것이 유일한 수단이다.
  //   dev/release 는 데이터 폴더부터 서로 다른 독립 배포다(discovery `default_data_dir`).
  //   대가(의도된 것): identifier 는 WebView2 데이터 폴더도 정하므로 dev 빌드의 웹 상태가 한 번
  //   초기화된다. 데몬 데이터 폴더(`.engram-data`)는 identifier 와 무관해 그대로다.
  //   ★값 제약★: `.app` 으로 끝내지 말 것(macOS 가 디렉터리를 앱으로 오인 — tauri#12674, CLI 가
  //   PR#13618 이후 거부한다) · 점 없는 단일 토큰 금지(Linux 크래시 — tauri#10353).
  "identifier": "com.engram.dashboard.dev",

  // 실측(2026-08-16 `tauri bundle`): productName 은 exe 이름을 바꾸지 않는다 — 그건 `mainBinaryName`
  //   담당이고 그나마 `tauri build` 에서만 적용된다. 여기선 산출물·표시 이름만 갈라 dev 결과물이
  //   릴리즈 이름으로 위장하지 않게 한다. 그래서 dev exe 는 양쪽 다 `engram-dashboard.exe` 이고,
  //   프로세스를 가르는 기준은 이름이 아니라 **exe 경로**다(dev = `target\debug\`).
  "productName": "engram-dashboard-dev"
}
