{
  "$schema": "https://schema.tauri.app/config/2",

  // ADR-0137 — a separate bundle identifier for dev builds (run alongside the release app)
  // ★dev-only overlay — never unify it with the identifier of release (`tauri.conf.json`) (do not bring it back)★
  //   tauri-plugin-single-instance builds the Windows global mutex name as `{identifier}-sim`
  //   (measured: tauri-plugin-single-instance 2.4.2 `src/platform_impl/windows.rs:67`). If the two builds use the same
  //   identifier they take the same mutex, so while the release app is up the dev app exits immediately with neither a window nor its own daemon
  //   (measured). The plugin Builder exposes no Windows name override
  //   (only `callback` and the Linux-only `dbus_id`), so splitting the identifier is the only means.
  //   dev/release are independent deployments, different down to the data folder (discovery `default_data_dir`).
  //   ★There are two injection points that actually feed this file (do not fix only one)★: (1) `scripts/tauri-cli.mjs`
  //   inserts it into the `tauri dev` subcommand with `--config` (Tauri CLI path only) · (2)
  //   `scripts/build-client-shell.mjs` carries it as `TAURI_CONFIG` and hands it to `cargo build -p engram-dashboard`
  //   (the path that does not go through the CLI — the two debug launcher `.bat` files and `/engram-qa` call that script).
  //   While (2) was missing, the debug exe was built with the release identifier (measured).
  //   The WebView2 data folder is not the identifier but `webview` under the data folder (`.engram-dev`) (TRD
  //   S21-storage §4) — only when that folder is not writable does it fall back to the identifier's Tauri default folder (`webview_env.rs`).
  //   ★Value constraints★: do not end it with `.app` (macOS mistakes a directory for an app — tauri#12674, the CLI rejects it
  //   since PR#13618) · no single token without a dot (Linux crash — tauri#10353).
  "identifier": "com.engram.dashboard.dev",

  // Measured (2026-08-16 `tauri bundle`): productName does not change the exe name — that is the job of `mainBinaryName`,
  //   and even that applies only in `tauri build`. Here only the artifact and display names are split so that the dev output does not
  //   pose as the release name. So the dev exe is `engram-dashboard.exe` on both sides,
  //   and what tells the processes apart is not the name but the **exe path** (dev = `target\debug\`).
  "productName": "engram-dashboard-dev"
}
