#!/bin/sh
# Blocks a commit while a line broken by the QA mutation check is still there — the marker comment is a block comment right after
# the changed token (mutate.mjs, // languages), or at the end of the line (.py/.rb and the older hand-written form). qa binding 「변이 확인」. # hangul-ok
# Install = `git config core.hooksPath scripts/git-hooks` once at the repository root (it applies to every worktree).
m='QA-''MUTATION'
hits=$(git diff --cached -U0 --no-color --no-ext-diff -- . ':(exclude)*.md' | awk '/^diff --git /{h=0;next} /^@@/{h=1;next} h' | grep -E "^\+.*(/[*][[:space:]]*${m}[[:space:]]*[*]/|(//|#|--|/[*])[[:space:]]*${m}[[:space:]]*([*]/)?[[:space:]]*\$)")
if [ -n "$hits" ]; then
	echo "commit blocked: qa mutation marker ${m} is staged — a broken line was not restored:" >&2
	echo "$hits" | head -5 >&2
	echo "Undo only the marked line (from the qa backup if known; do not restore the file from git), then commit again." >&2
	exit 1
fi
exit 0
