#!/bin/sh
# QA 변이 확인이 깬 줄(줄 끝 표식 주석)이 남은 채 커밋되는 것을 막는다 — qa 바인딩 「변이 확인」.
# 설치 = 저장소 루트에서 `git config core.hooksPath scripts/git-hooks` 한 번(모든 워크트리에 걸린다).
m='QA-''MUTATION'
hits=$(git diff --cached -U0 --no-color --no-ext-diff -- . ':(exclude)*.md' | awk '/^diff --git /{h=0;next} /^@@/{h=1;next} h' | grep -E "^\+.*(//|#|--|/[*])[[:space:]]*${m}[[:space:]]*([*]/)?[[:space:]]*\$")
if [ -n "$hits" ]; then
	echo "commit blocked: qa mutation marker ${m} is staged — a broken line was not restored:" >&2
	echo "$hits" | head -5 >&2
	echo "Undo only the marked line (from the qa backup if known; do not restore the file from git), then commit again." >&2
	exit 1
fi
exit 0
