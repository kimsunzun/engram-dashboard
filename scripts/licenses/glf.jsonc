// generate-license-file settings — the npm part of THIRD_PARTY_LICENSES.txt. Caller = scripts/gen-third-party-licenses.mjs
//   (passes this file with `--config`). Paths are relative to this file. ★Use only whole-line `//` comments★ — the generator script also
//   reads this file (the key check below), stripping only line comments and reading it as JSON.
{
  // When the tool cannot find the license text, it carries package.json's one-line SPDX identifier ("MIT") or an unrelated file as the text — the permission
  //   wording goes missing, so the generator script blocks such entries as failures, and the text is supplied here.
  // ★Keys are `<name>@<version>` with the exact version★ — the tool supplies it only for that version, and the generator script fails if that name@version is not
  //   among the installed production dependencies (the version changed or the package dropped out). For a new version, recheck the text and fix the key.
  "replace": {
    // The tool cannot find the license file names (LICENSE_MIT · LICENSE_APACHE-2.0). Of the dual license, MIT is picked — the same priority as the Rust side.
    "@tauri-apps/api@2.11.0": "../../node_modules/@tauri-apps/api/LICENSE_MIT",
    // These two carry only an SPDX metadata document (LICENSE.spdx) instead of a license file, and the tool picks that as the text. The LICENSE_MIT that the Rust
    //   crates of the same version (tauri-plugin-dialog · tauri-plugin-opener) carry is identical, letter for letter, to the one of @tauri-apps/api above (measured 2026-10-15).
    "@tauri-apps/plugin-dialog@2.7.1": "../../node_modules/@tauri-apps/api/LICENSE_MIT",
    "@tauri-apps/plugin-opener@2.5.4": "../../node_modules/@tauri-apps/api/LICENSE_MIT",
    // The platform binary packages have no license file — the one of the main package installed alongside at the same version (esbuild · rollup) is used.
    "@esbuild/win32-x64@0.25.12": "../../node_modules/esbuild/LICENSE.md",
    "@rollup/rollup-win32-x64-gnu@4.61.1": "../../node_modules/rollup/LICENSE.md",
    "@rollup/rollup-win32-x64-msvc@4.61.1": "../../node_modules/rollup/LICENSE.md",
    // The four below have no license file at all in their npm package — the upstream repository's file is downloaded into npm/. The commit is the gitHead of that
    //   version recorded by the npm registry (`npm view <package>@<version> gitHead`). When the version is raised, download it again the same way.
    // react-arborist 3.9.0 = github.com/jameskerr/react-arborist @ 3c6a9a7d3d023a52dbd3a9da88b87154328191dc : LICENSE
    "react-arborist@3.9.0": "npm/react-arborist.txt",
    // The gitHead (b3b1287a…) of react-remove-scroll-bar 2.3.8 was never pushed to GitHub, and when that version was released (2024-12-15), upstream had
    //   no LICENSE. Later the contributor monholm added one in PR #76 (commit 7301c160) and the maintainer accepted it on 2025-05-26 —
    //   it is MIT in the name 「Copyright (c) 2025 Anton Korzunov」 (the maintainer) (the same as the MIT declaration in package.json). That file is used =
    //   github.com/theKashey/react-remove-scroll-bar @ 8ca9ba5ea52de03308fe8ced94f7b159a44d28ff (that PR's merge commit) : LICENSE
    "react-remove-scroll-bar@2.3.8": "npm/react-remove-scroll-bar.txt",
    // Both are the root license of github.com/remarkjs/remark-math — rehype-katex 7.0.1 @ 88a9497e1ede93b958237c85edbf5651faeca7af ·
    //   remark-math 6.0.0 @ d5d0660b150810a535bbb07eac6cc96a4510aa24 (the text of the two versions is the same).
    "rehype-katex@7.0.1": "npm/rehype-katex.txt",
    "remark-math@6.0.0": "npm/remark-math.txt"
  }
}
