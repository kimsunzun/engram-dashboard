+//! 창을 첫 화면까지 숨긴다 — main · 팝아웃은 숨긴 채 짓고([`hold_window`]), 페이지가 실제 첫 화면(탭바 + 활성 탭)을
+//! 그렸다고 알리면(`webview_painted` · `src/theme/firstPaint.ts`) 창을 보인다. 사용자 결정(2026-10-19): 창은 내용과
+//! 함께 뜬다 — 틀을 먼저 띄우지 않는다(네이티브 틀은 걷힐 예정이다).
+//!
+//! - ★웹뷰는 숨기지 않는다 — 숨긴 창 안에서 그리게 둔다★: 숨긴 웹뷰(`Webview::hide`)를 다시 보이는 순간 WebView2 가 아직
+//!   그리지 않은 면을 한 번 보였다(사용자 관측 2026-10-19 「창이 뜨고 좀 있다가 깜박임」).
+//! - ★창을 보이는 것은 [`hold_window`] 로 올린 창 하나에 한 번뿐이다★ — 알림과 [`FALLBACK_REVEAL`] 중 먼저 온 쪽. 올리지
+//!   않은 창(`--hidden` 부팅의 main · 런타임 복원 수락의 숨은 창 · 예비 창 · 다시 읽기)의 알림은 아무 일도 하지 않는다.
+//! - ★보이기는 메인 스레드에서 한다★ — 알림은 동기 명령(메인 스레드)이고 시한은 메인 스레드로 넘긴다. 보이는 법은
+//!   [`crate::state::placement::show_placed`] 다(미룬 최대화가 있으면 보통 크기 틀 없이 최대화로 보인다).
+//! - 숨긴 채 짓는 까닭이 하나 더 있다 — tao 0.35.3 은 보이는 창의 보이기를 창 만들기(`init`) 끝에서 하는데 창 바탕을
+//!   칠하는 서브클래스(`WM_ERASEBKGND`)는 그 뒤에 달아, 첫 프레임 안쪽이 칠해지지 않은 채 창 뒤가 비쳤다(사용자 영상
+//!   2026-10-19 · `platform_impl/windows/window.rs` — 소스 독해). 지은 뒤의 보이기는 바탕색으로 지운다.
+//! - 숨은 동안 페이지가 실제로 그리는지(WebView2 가 부모 창 숨김을 가림으로 보고 그리기를 멈추는지)는 [미검 — GUI]. 멈추면
+//!   보인 직후 한순간 바탕색이다.
+
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use engram_dashboard_base::sync;
+use tauri::{AppHandle, Manager, WebviewWindow};
+
+/// 첫 화면 알림을 기다리는 상한 — 넘으면 알림 없이 보인다. 덮는 것 = 페이지 읽기 · 번들 실행 · 첫 마운트 · 탭 목록과 활성
+/// 탭 레이아웃 조회. 값은 실측이 아니라 「넘으면 깨진 것으로 본다」는 판단이다(개발 서버로 띄운 창은 0.8~1.1 s — 사용자
+/// 관측 2026-10-19). 넘으면 첫 화면 전에 보인다.
+pub(crate) const FALLBACK_REVEAL: Duration = Duration::from_millis(1500);
+
+/// 보이기를 기다리는 숨긴 창의 명부 — label → 올린 차례 번호. 보이기는 명부에서 그 항목을 빼낸 쪽 하나만 한다(첫 화면
+/// 알림과 시한 중 먼저 온 쪽). 셸에 하나다(빌더에서 manage — 창을 만드는 어느 자리보다 먼저 있어야 한다).
+#[derive(Default)]
+pub(crate) struct FirstPaintGate {
+    held: Mutex<HashMap<String, u64>>,
+    next: AtomicU64,
+}
+
+impl FirstPaintGate {
+    fn hold(&self, label: &str) -> u64 {
+        let ticket = self.next.fetch_add(1, Ordering::Relaxed);
+        sync::lock(&self.held).insert(label.to_owned(), ticket);
+        ticket
+    }
+
+    fn release_painted(&self, label: &str) -> bool {
+        sync::lock(&self.held).remove(label).is_some()
+    }
+
+    // 시한은 자기가 올린 차례일 때만 빼낸다 — 그 사이 같은 label 의 창을 다시 만들어 올렸으면 그 창의 시한이 따로 돈다.
+    fn release_overdue(&self, label: &str, ticket: u64) -> bool {
+        let mut held = sync::lock(&self.held);
+        if held.get(label) != Some(&ticket) {
+            return false;
+        }
+        held.remove(label);
+        true
+    }
+}
+
+/// 숨긴 채 지은 창을 첫 화면 알림(또는 [`FALLBACK_REVEAL`])에 보이도록 올린다. ★창은 숨은 채여야 하고 자리 · 미룬 최대화를
+/// 이미 입혔어야 한다★ — 보이기가 그 자리 그대로 보인다. 명부가 등록돼 있지 않으면 곧바로 보인다(보일 길이 없는 숨은 창을
+/// 만들지 않는다).
+pub(crate) fn hold_window(window: &WebviewWindow) {
+    let Some(gate) = window.try_state::<Arc<FirstPaintGate>>() else {
+        tracing::warn!(
+            module = "first_paint",
+            label = window.label(),
+            "첫 화면 명부가 등록돼 있지 않아 창을 곧바로 보인다"
+        );
+        show(window);
+        return;
+    };
+    let gate = gate.inner().clone();
+    let label = window.label().to_owned();
+    let ticket = gate.hold(&label);
+    let app = window.app_handle().clone();
+    tauri::async_runtime::spawn(reveal_when_overdue(
+        gate,
+        label,
+        ticket,
+        FALLBACK_REVEAL,
+        move |label| show_on_main_thread(&app, label),
+    ));
+}
+
+/// 그 창의 첫 화면 알림 — 올린 창이면 보이고, 아니면 아무 일도 하지 않는다. 메인 스레드에서 부른다(동기 명령).
+pub(crate) fn reveal_painted(window: &WebviewWindow) {
+    let Some(gate) = window.try_state::<Arc<FirstPaintGate>>() else {
+        return;
+    };
+    if gate.release_painted(window.label()) {
+        show(window);
+    }
+}
+
+async fn reveal_when_overdue(
+    gate: Arc<FirstPaintGate>,
+    label: String,
+    ticket: u64,
+    after: Duration,
+    reveal: impl FnOnce(&str),
+) {
+    tokio::time::sleep(after).await;
+    if gate.release_overdue(&label, ticket) {
+        tracing::warn!(
+            module = "first_paint",
+            label = %label,
+            "첫 화면 알림이 시한 안에 오지 않아 창을 보인다"
+        );
+        reveal(&label);
+    }
+}
+
+fn show_on_main_thread(app: &AppHandle, label: &str) {
+    let handle = app.clone();
+    let label = label.to_owned();
+    let queued = app.run_on_main_thread(move || match handle.get_webview_window(&label) {
+        Some(window) => show(&window),
+        None => tracing::debug!(module = "first_paint", label, "시한 전에 창이 닫혔다"),
+    });
+    if let Err(e) = queued {
+        tracing::warn!(
+            module = "first_paint",
+            "숨긴 창을 보이는 일을 메인 스레드에 넘기지 못했다: {e}"
+        );
+    }
+}
+
+fn show(window: &WebviewWindow) {
+    crate::state::placement::show_placed(&window.as_ref().window());
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    // ── 명부 ──
+
+    #[test]
+    fn the_painted_signal_releases_a_held_window_once() {
+        let gate = FirstPaintGate::default();
+        gate.hold("main");
+        assert!(gate.release_painted("main"));
+        assert!(
+            !gate.release_painted("main"),
+            "두 번째 알림은 보이지 않는다"
+        );
+    }
+
+    #[test]
+    fn a_signal_from_a_window_that_was_not_held_does_nothing() {
+        let gate = FirstPaintGate::default();
+        assert!(!gate.release_painted("slot-popup-1"));
+    }
+
+    #[test]
+    fn the_deadline_does_not_reveal_after_the_painted_signal() {
+        let gate = FirstPaintGate::default();
+        let ticket = gate.hold("main");
+        assert!(gate.release_painted("main"));
+        assert!(!gate.release_overdue("main", ticket));
+    }
+
+    #[test]
+    fn the_painted_signal_does_nothing_after_the_deadline() {
+        let gate = FirstPaintGate::default();
+        let ticket = gate.hold("main");
+        assert!(gate.release_overdue("main", ticket));
+        assert!(!gate.release_painted("main"));
+    }
+
+    #[test]
+    fn an_old_deadline_does_not_reveal_a_window_held_again_under_the_same_label() {
+        let gate = FirstPaintGate::default();
+        let old = gate.hold("slot-popup-1");
+        assert!(gate.release_painted("slot-popup-1"));
+        let new = gate.hold("slot-popup-1");
+        assert!(!gate.release_overdue("slot-popup-1", old));
+        assert!(gate.release_overdue("slot-popup-1", new));
+    }
+
+    // ── 시한 ──
+
+    fn recorder() -> (Arc<Mutex<Vec<String>>>, impl FnOnce(&str)) {
+        let seen = Arc::new(Mutex::new(Vec::new()));
+        let sink = seen.clone();
+        (seen, move |label: &str| {
+            sink.lock().unwrap().push(label.to_owned())
+        })
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn without_a_signal_the_deadline_reveals_the_window_once() {
+        let gate = Arc::new(FirstPaintGate::default());
+        let ticket = gate.hold("main");
+        let (seen, reveal) = recorder();
+        let task = tokio::spawn(reveal_when_overdue(
+            gate.clone(),
+            "main".to_owned(),
+            ticket,
+            FALLBACK_REVEAL,
+            reveal,
+        ));
+
+        tokio::time::sleep(FALLBACK_REVEAL - Duration::from_millis(1)).await;
+        assert!(seen.lock().unwrap().is_empty(), "시한 전에는 보이지 않는다");
+
+        task.await.unwrap();
+        assert_eq!(*seen.lock().unwrap(), vec!["main".to_owned()]);
+        assert!(
+            !gate.release_painted("main"),
+            "늦은 알림은 다시 보이지 않는다"
+        );
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn a_signal_before_the_deadline_leaves_the_deadline_nothing_to_do() {
+        let gate = Arc::new(FirstPaintGate::default());
+        let ticket = gate.hold("main");
+        let (seen, reveal) = recorder();
+        let task = tokio::spawn(reveal_when_overdue(
+            gate.clone(),
+            "main".to_owned(),
+            ticket,
+            FALLBACK_REVEAL,
+            reveal,
+        ));
+
+        assert!(gate.release_painted("main"));
+        task.await.unwrap();
+        assert!(seen.lock().unwrap().is_empty());
+    }
+}
