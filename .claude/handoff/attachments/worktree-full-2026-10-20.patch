diff --git a/src/components/layout/dock/dockDiag.ts b/src/components/layout/dock/dockDiag.ts
new file mode 100644
index 00000000..accba7d6
--- /dev/null
+++ b/src/components/layout/dock/dockDiag.ts
@@ -0,0 +1,14 @@
+// 도킹 진단 줄 — 탭바 머리가 모두 사라졌다 돌아온 뒤 그 창에 붙지 않는 결함(B1 · 원인 미확정)의 다음 재현에서 「탭바 보고가
+//   비었나 · 낡았나」를 가르려고 둔다. 웹뷰 → 셸 로그 다리가 없어 앱 로그 파일에는 가지 않고 그 창 콘솔에만 남는다 — 재현
+//   때는 그 창 DevTools(CDP 9223)에서 머리 `[dock-diag]` 로 거른다.
+
+/**
+ * `warn` = 이상(머리가 모두 숨음 · 창 틀 보고 건너뜀 · 다시 · 끌기를 열지 못함 · 줄 폭 없이 끌기) · `debug` = 늘 있는 바뀜(창
+ * 부팅마다 지나는 창 모드 등). DevTools 기본 거르기는 `debug` 를 숨긴다 — 재현 때는 Verbose 를 켠다.
+ */
+export type DockDiagLevel = 'warn' | 'debug'
+
+export function dockDiag(what: string, data: Record<string, unknown>, level: DockDiagLevel = 'warn'): void {
+  if (level === 'debug') console.debug(`[dock-diag] ${what}`, data)
+  else console.warn(`[dock-diag] ${what}`, data)
+}
