+    let status = unsafe {
+        NtQueryInformationProcess(
+            handle,
+            ProcessBasicInformation,
+            (&mut info as *mut PROCESS_BASIC_INFORMATION).cast(),
+            size,
+            &mut written,
+        )
+    };
+    // 돌려받은 크기까지 맞아야 배치를 믿는다.
+    if status.is_err() || written != size {
+        return None;
+    }
+    u32::try_from(info.inherited_from_unique_process_id).ok()
+}
