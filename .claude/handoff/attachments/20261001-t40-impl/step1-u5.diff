+    let mut len = IMAGE_PATH_CHARS as u32;
+    // SAFETY: 유효 핸들 + 길이를 알려 준 쓰기 가능 버퍼 + 스택 입출력 길이.
+    unsafe {
+        QueryFullProcessImageNameW(
+            handle,
+            PROCESS_NAME_WIN32,
+            PWSTR(buf.as_mut_ptr()),
+            &mut len,
+        )
+    }
+    .ok()?;
+    buf.get(..len as usize).map(String::from_utf16_lossy)
+}
