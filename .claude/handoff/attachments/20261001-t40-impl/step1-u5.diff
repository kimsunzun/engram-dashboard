+            let (script_pid, script) = births
+                .iter()
+                .find(|(_, m)| m.facts().ppid == root && runs(m, "\\bash.exe"))?;
+            let (_, fork) = births
+                .iter()
+                .find(|(_, m)| m.facts().ppid == *script_pid && runs(m, "\\bash.exe"))?;
