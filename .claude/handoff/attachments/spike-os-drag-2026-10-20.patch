@@ -0,0 +1,339 @@
+// SPIKE (throwaway — OS/HTML5 tab drag measurement 2026-10-20). Not production code.
+// Installs document-level listeners that LOG every drag event (+ timing), accept our custom MIME, and draw a
+// preview overlay (tab-strip insertion marker / 10% dock band rectangle) from the target window's own dragover.
+// Collected via CDP: window.__SPK.pull().
+import { invoke } from '@tauri-apps/api/core'
+
+export const MIME = 'application/x-engram-tab'
+
+type Entry = Record<string, unknown>
+const now = (): number => Math.round((performance.timeOrigin + performance.now()) * 100) / 100
+
+interface Spk {
+  log: Entry[]
+  cfg: { singleTabMoveWindow: boolean; overlay: boolean; dragImage: 'label' | 'none' | 'element' }
+  pull: () => Entry[]
+  clear: () => void
+  frames: number[]
+}
+
+const spk: Spk = {
+  log: [],
+  cfg: { singleTabMoveWindow: false, overlay: true, dragImage: 'label' },
+  pull() {
+    const out = spk.log
+    spk.log = []
+    return out
+  },
+  clear() {
+    spk.log = []
+    spk.frames = []
+  },
+  frames: [],
+}
+
+function push(e: Entry): void {
+  if (spk.log.length > 50000) spk.log.shift()
+  spk.log.push(e)
+}
+
+function tgtOf(t: EventTarget | null): string {
+  if (!(t instanceof Element)) return String(t)
+  const slot = t.closest('[data-slot-id]')
+  const tid = t.closest('[data-testid]')
+  const parts: string[] = []
+  if (tid) parts.push(tid.getAttribute('data-testid') ?? '')
+  const v = t.closest('[data-view-id]')
+  if (v) parts.push('v=' + v.getAttribute('data-view-id'))
+  if (slot) parts.push('slot=' + slot.getAttribute('data-slot-id'))
+  return parts.join('|')
+}
+
+function base(ev: string, e: DragEvent | MouseEvent): Entry {
+  const dt = (e as DragEvent).dataTransfer ?? null
+  return {
+    t: now(),
+    ev,
+    x: Math.round(e.clientX * 10) / 10,
+    y: Math.round(e.clientY * 10) / 10,
+    sx: e.screenX,
+    sy: e.screenY,
+    btn: e.buttons,
+    tgt: tgtOf(e.target),
+    types: dt ? Array.from(dt.types) : undefined,
+    de: dt ? dt.dropEffect : undefined,
+    ea: dt ? dt.effectAllowed : undefined,
+  }
+}
+
+// ---------- overlay ----------
+let overlay: HTMLDivElement | null = null
+let marker: HTMLDivElement | null = null
+function ensureOverlay(): void {
+  if (overlay) return
+  overlay = document.createElement('div')
+  overlay.style.cssText =
+    'position:fixed;pointer-events:none;z-index:99999;background:rgba(80,140,255,0.25);border:2px solid rgba(80,140,255,0.9);display:none;box-sizing:border-box'
+  marker = document.createElement('div')
+  marker.style.cssText =
+    'position:fixed;pointer-events:none;z-index:99999;background:#4a8cff;width:2px;display:none'
+  document.body.appendChild(overlay)
+  document.body.appendChild(marker)
+}
+function hide(): void {
+  if (overlay) overlay.style.display = 'none'
+  if (marker) marker.style.display = 'none'
+}
+
+interface Zone {
+  kind: 'strip' | 'band' | 'center' | 'other'
+  index?: number
+  side?: string
+  slot?: string
+  rect?: [number, number, number, number]
+}
+
+function zoneAt(e: DragEvent): Zone {
+  const t = e.target instanceof Element ? e.target : null
+  if (t === null) return { kind: 'other' }
+  const row = t.closest('[data-testid="tab-bar"]')?.querySelector('[data-testid="tab-strip-row"]') ?? null
+  if (row) {
+    const heads = Array.from(row.querySelectorAll('[data-testid="tab"]')) as HTMLElement[]
+    const rs = heads.map(h => h.getBoundingClientRect()).sort((a, b) => a.left - b.left)
+    let index = rs.length
+    for (let i = 0; i < rs.length; i++) {
+      if (e.clientX < rs[i].left + rs[i].width / 2) {
+        index = i
+        break
+      }
+    }
+    const rr = row.getBoundingClientRect()
+    const x = index < rs.length ? rs[index].left : rs.length ? rs[rs.length - 1].right : rr.left
+    return { kind: 'strip', index, rect: [x, rr.top, 2, rr.height] }
+  }
+  const slot = t.closest('[data-slot-id]') as HTMLElement | null
+  if (slot) {
+    const r = slot.getBoundingClientRect()
+    const fx = (e.clientX - r.left) / r.width
+    const fy = (e.clientY - r.top) / r.height
+    const id = slot.getAttribute('data-slot-id') ?? ''
+    const B = 0.1
+    let side: string | null = null
+    if (fx < B) side = 'left'
+    else if (fx > 1 - B) side = 'right'
+    else if (fy < B) side = 'top'
+    else if (fy > 1 - B) side = 'bottom'
+    if (side === null) return { kind: 'center', slot: id }
+    // preview = half of the slot on that side (cap) — spike only
+    const rect: [number, number, number, number] =
+      side === 'left'
+        ? [r.left, r.top, r.width / 2, r.height]
+        : side === 'right'
+          ? [r.left + r.width / 2, r.top, r.width / 2, r.height]
+          : side === 'top'
+            ? [r.left, r.top, r.width, r.height / 2]
+            : [r.left, r.top + r.height / 2, r.width, r.height / 2]
+    return { kind: 'band', side, slot: id, rect }
+  }
+  return { kind: 'other' }
+}
+
+function draw(z: Zone): void {
+  if (!spk.cfg.overlay) return
+  ensureOverlay()
+  if (z.kind === 'strip' && z.rect && marker) {
+    if (overlay) overlay.style.display = 'none'
+    marker.style.display = 'block'
+    marker.style.left = z.rect[0] - 1 + 'px'
+    marker.style.top = z.rect[1] + 'px'
+    marker.style.height = z.rect[3] + 'px'
+  } else if (z.kind === 'band' && z.rect && overlay) {
+    if (marker) marker.style.display = 'none'
+    overlay.style.display = 'block'
+    overlay.style.left = z.rect[0] + 'px'
+    overlay.style.top = z.rect[1] + 'px'
+    overlay.style.width = z.rect[2] + 'px'
+    overlay.style.height = z.rect[3] + 'px'
+  } else hide()
+}
+
+// ---------- rAF frame monitor during a drag (this window) ----------
+let rafOn = false
+let lastFrame = 0
+function frameLoop(ts: number): void {
+  if (!rafOn) return
+  if (lastFrame) spk.frames.push(Math.round((ts - lastFrame) * 10) / 10)
+  lastFrame = ts
+  requestAnimationFrame(frameLoop)
+}
+function startFrames(): void {
+  if (rafOn) return
+  rafOn = true
+  lastFrame = 0
+  requestAnimationFrame(frameLoop)
+}
+function stopFrames(): void {
+  rafOn = false
+}
+
+function ours(e: DragEvent): boolean {
+  return !!e.dataTransfer && Array.from(e.dataTransfer.types).includes(MIME)
+}
+
+let lastZoneKey = ''
+
+export function installSpike(): void {
+  ;(window as unknown as { __SPK: Spk }).__SPK = spk
+  push({ t: now(), ev: 'install', href: location.href })
+
+  // source-side start (from TabBar)
+  document.addEventListener(
+    'dragenter',
+    e => {
+      const zz = ours(e) ? zoneAt(e) : undefined
+      push({ ...base('dragenter', e), rt: tgtOf(e.relatedTarget), zone: zz?.kind })
+      if (ours(e)) {
+        e.preventDefault()
+        e.dataTransfer!.dropEffect = 'move'
+        startFrames()
+      }
+    },
+    true,
+  )
+  document.addEventListener(
+    'dragover',
+    e => {
+      const h0 = performance.now()
+      if (ours(e)) {
+        e.preventDefault()
+        e.dataTransfer!.dropEffect = 'move'
+        const z = zoneAt(e)
+        draw(z)
+        const key = `${z.kind}:${z.index ?? ''}:${z.side ?? ''}:${z.slot ?? ''}`
+        const changed = key !== lastZoneKey
+        lastZoneKey = key
+        push({ ...base('dragover', e), zone: z.kind, idx: z.index, side: z.side, slot: z.slot, zc: changed ? 1 : 0, hms: Math.round((performance.now() - h0) * 100) / 100 })
+      } else {
+        push({ ...base('dragover', e) })
+      }
+    },
+    true,
+  )
+  document.addEventListener(
+    'dragleave',
+    e => {
+      push({ ...base('dragleave', e), rt: tgtOf(e.relatedTarget) })
+      // leaving the document (relatedTarget null) — hide preview
+      if (e.relatedTarget === null) {
+        hide()
+        lastZoneKey = ''
+      }
+    },
+    true,
+  )
+  document.addEventListener(
+    'drop',
+    e => {
+      const dt = e.dataTransfer
+      const z = ours(e) ? zoneAt(e) : undefined
+      const entry: Entry = {
+        ...base('drop', e),
+        zone: z?.kind,
+        idx: z?.index,
+        side: z?.side,
+        slot: z?.slot,
+        data: dt ? dt.getData(MIME) : undefined,
+        plain: dt ? dt.getData('text/plain') : undefined,
+        uri: dt ? dt.getData('text/uri-list') : undefined,
+        html: dt ? dt.getData('text/html') : undefined,
+        files: dt ? dt.files.length : undefined,
+        items: dt ? Array.from(dt.items).map(i => `${i.kind}:${i.type}`) : undefined,
+      }
+      push(entry)
+      if (ours(e)) e.preventDefault()
+      hide()
+      lastZoneKey = ''
+      stopFrames()
+    },
+    true,
+  )
+  // source side
+  let dragN = 0
+  document.addEventListener(
+    'drag',
+    e => {
+      dragN++
+      // log every drag event (rate) but compact
+      push({ t: now(), ev: 'drag', x: e.clientX, y: e.clientY, sx: e.screenX, sy: e.screenY })
+    },
+    true,
+  )
+  document.addEventListener(
+    'dragend',
+    e => {
+      const tEnd = now()
+      const entry = { ...base('dragend', e), dragN }
+      dragN = 0
+      push(entry)
+      hide()
+      lastZoneKey = ''
+      stopFrames()
+      const t0 = now()
+      invoke<Record<string, unknown>>('spike_input_state')
+        .then(r => push({ ev: 'shellstate', tReq: t0, tEnd, ...r, tJs: now() }))
+        .catch(err => push({ t: now(), ev: 'shellstate-err', err: String(err) }))
+      setTimeout(() => {
+        const t1 = now()
+        invoke<Record<string, unknown>>('spike_input_state')
+          .then(r => push({ ev: 'shellstate30', tReq: t1, ...r, tJs: now() }))
+          .catch(() => {})
+      }, 30)
+    },
+    true,
+  )
+  for (const ev of ['pointerdown', 'pointerup', 'click', 'dblclick', 'mousedown'] as const) {
+    document.addEventListener(
+      ev,
+      e => {
+        const t = e.target instanceof Element ? e.target : null
+        if (t && t.closest('[data-testid="tab-bar"]')) push(base(ev, e as MouseEvent))
+      },
+      true,
+    )
+  }
+  window.addEventListener('keydown', e => push({ t: now(), ev: 'keydown', key: e.key }), true)
+  window.addEventListener('blur', () => push({ t: now(), ev: 'winblur' }))
+  window.addEventListener('focus', () => push({ t: now(), ev: 'winfocus' }))
+  window.addEventListener('beforeunload', () => push({ t: now(), ev: 'beforeunload' }))
+}
+
+/** Called from TabBar's head onDragStart. */
+export function spikeDragStart(e: React.DragEvent, view: string, name: string, label: string, tabCount: number): void {
+  const dt = e.dataTransfer
+  push({ ...base('dragstart', e.nativeEvent), view, label, tabCount })
+  if (spk.cfg.singleTabMoveWindow && tabCount === 1) {
+    e.preventDefault()
+    push({ t: now(), ev: 'startDragging-request' })
+    import('@tauri-apps/api/window').then(({ getCurrentWindow }) =>
+      getCurrentWindow()
+        .startDragging()
+        .then(() => push({ t: now(), ev: 'startDragging-resolved' }))
+        .catch(err => push({ t: now(), ev: 'startDragging-err', err: String(err) })),
+    )
+    return
+  }
+  dt.setData(MIME, JSON.stringify({ view, label }))
+  dt.effectAllowed = 'move'
+  if (spk.cfg.dragImage === 'label') {
+    // VS Code style: a small label element, appended, used as drag image, removed next tick
+    const el = document.createElement('div')
+    el.textContent = name || view
+    el.style.cssText =
+      'position:absolute;top:-1000px;left:-1000px;padding:4px 10px;font:12px var(--font-ui, sans-serif);background:var(--bg-secondary,#222);color:var(--text,#ddd);border:1px solid var(--border,#555);border-radius:4px;white-space:nowrap'
+    document.body.appendChild(el)
+    const r = el.getBoundingClientRect()
+    dt.setDragImage(el, -10, -10)
+    push({ t: now(), ev: 'dragimage', w: r.width, h: r.height, dpr: window.devicePixelRatio })
+    setTimeout(() => el.remove(), 0)
+  }
+}
