+/// SPIKE (throwaway): async key state of a virtual key (e.g. 0x1B Esc, 0x01 LBUTTON).
+pub fn spike_key_down(vk: i32) -> bool {
+    #[cfg(windows)]
+    {
+        use windows::Win32::UI::Input::KeyboardAndMouse::GetAsyncKeyState;
+        // SAFETY: value-only query.
+        unsafe { (GetAsyncKeyState(vk) as u16 & 0x8000) != 0 }
+    }
+    #[cfg(not(windows))]
+    {
+        let _ = vk;
+        false
+    }
+}
