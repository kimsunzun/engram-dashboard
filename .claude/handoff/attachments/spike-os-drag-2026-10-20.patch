+// SPIKE (throwaway, OS-drag measurement 2026-10-20): read cursor + key state right after an HTML5 dragend.
+use engram_dashboard_platform::input;
+
+#[derive(serde::Serialize)]
+pub struct SpikeInputState {
+    pub t: f64,
+    pub x: i32,
+    pub y: i32,
+    pub lbutton: bool,
+    pub rbutton: bool,
+    pub esc: bool,
+    pub t_end: f64,
+}
+
+fn now_ms() -> f64 {
+    std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs_f64() * 1000.0)
+        .unwrap_or(0.0)
+}
+
+#[tauri::command]
+pub fn spike_input_state() -> SpikeInputState {
+    let t = now_ms();
+    let p = input::cursor_pos().unwrap_or_default();
+    let lbutton = input::spike_key_down(0x01);
+    let rbutton = input::spike_key_down(0x02);
+    let esc = input::spike_key_down(0x1B);
+    SpikeInputState { t, x: p.x, y: p.y, lbutton, rbutton, esc, t_end: now_ms() }
+}
